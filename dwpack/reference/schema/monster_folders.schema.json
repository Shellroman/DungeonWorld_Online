{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DWPack monster folders",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "uid",
      "name"
    ],
    "properties": {
      "uid": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "^[A-Za-z0-9._:-]+$"
      },
      "name": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      },
      "sort_order": {
        "type": "integer"
      }
    },
    "additionalProperties": false
  }
}
