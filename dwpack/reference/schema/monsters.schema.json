{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DWPack monsters",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "uid",
      "name",
      "data"
    ],
    "properties": {
      "uid": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "^[A-Za-z0-9._:-]+$"
      },
      "name": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      },
      "folder_uid": {
        "oneOf": [
          {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9._:-]+$"
          },
          {
            "type": "null"
          }
        ]
      },
      "sort_order": {
        "type": "integer"
      },
      "data": {
        "type": "object"
      }
    },
    "additionalProperties": false
  }
}
